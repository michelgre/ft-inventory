	<property name="net.sf.jasperreports.print.create.bookmarks" value="true"/>
	<parameter name="BoxCondition" class="java.lang.String"/>
	<parameter name="InventoryBoxURL" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT b.id box_id,
	b.label box_label,
	p.id part_id,
	coalesce( pl1.label,pl2.label) part_label,
	bc.count,
	bin.id bin_id,
	bin.label bin_label,
	i.tn_100, 
	REPLACE('$P!{InventoryBoxURL}','{id}',CAST(b.id as varchar)) as qrCode
FROM box b
	JOIN v_box_contains bc ON 
	 bc.container_id = b.id 
	JOIN part p ON 
	 p.id = bc.part_id 
	LEFT JOIN multilingual_label pl1 ON 
	 pl1.id = p.title_id 
	 AND pl1.langcode = 'fr' 
	LEFT JOIN multilingual_label pl2 ON 
	 pl2.id = p.title_id 
	 AND pl2.langcode = 'de' 
	LEFT JOIN image i ON 
	 i.id = p.ft_icon
	LEFT JOIN box bin ON bin.id = bc.bin_id 
WHERE
  $P!{BoxCondition}
ORDER BY bin.id, part_label]]>
	</queryString>
