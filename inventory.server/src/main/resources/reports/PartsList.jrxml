<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PartsList" columnCount="2" printOrder="Horizontal" pageWidth="496" pageHeight="705" columnWidth="234" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" isTitleNewPage="true" isSummaryNewPage="true" uuid="30b1f22d-152a-4797-90c7-480ba699612c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
