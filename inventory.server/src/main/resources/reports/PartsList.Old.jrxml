	<style name="Code 39" fontName="C39T30Lfz"/>
	<parameter name="BoxCondition" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT b.id box_id,
	b.label box_label,
	p.id part_id,
	coalesce( pl1.label,pl2.label) part_label,
	bc.count,
	i.tn_100
FROM box b
	JOIN v_box_contains bc ON 
	 bc.container_id = b.id 
	JOIN part p ON 
	 p.id = bc.part_id 
	LEFT JOIN multilingual_label pl1 ON 
	 pl1.id = p.title_id 
	 AND pl1.langcode = 'fr' 
	LEFT JOIN multilingual_label pl2 ON 
	 pl2.id = p.title_id 
	 AND pl2.langcode = 'de' 
	LEFT JOIN image i ON 
	 i.id = p.ft_icon 
WHERE
  $P!{BoxCondition}]]>
	</queryString>
